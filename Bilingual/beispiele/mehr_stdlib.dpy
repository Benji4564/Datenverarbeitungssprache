von bilingualpython.stdlib.deutsch importiere pfadobjekte, kennung, aufzaehlung, datenklassen
von bilingualpython.vokabular.deutsch importiere drucke


klasse Status(aufzaehlung.Aufzählung):
    OFFEN = aufzaehlung.automatisch()
    ERLEDIGT = aufzaehlung.automatisch()


@datenklassen.datenklasse
klasse Aufgabe:
    titel: str
    status: Status = Status.OFFEN


wenn __name__ == "__main__":
    aufgabe = Aufgabe("Deutsch-Python fertigstellen")
    drucke(aufgabe.titel, "-", aufgabe.status)

    dieser_ordner = pfadobjekte.Pfad(__file__).parent
    drucke("Beispiel-Ordner:", dieser_ordner)

    eindeutige_id = kennung.zufalls_id()
    drucke("Zufällige ID:", eindeutige_id)
