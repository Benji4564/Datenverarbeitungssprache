{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Deutsch-Python",
  "scopeName": "source.dpy",
  "patterns": [
    { "include": "#kommentare" },
    { "include": "#zeichenketten" },
    { "include": "#dekoratoren" },
    { "include": "#klassendefinition" },
    { "include": "#funktionsdefinition" },
    { "include": "#schluesselwoerter" },
    { "include": "#konstanten" },
    { "include": "#zahlen" },
    { "include": "#eingebaute-funktionen" },
    { "include": "#selbst" },
    { "include": "#funktionsaufruf" },
    { "include": "#attributzugriff" },
    { "include": "#zuweisung" },
    { "include": "#operatoren" }
  ],
  "repository": {
    "kommentare": {
      "patterns": [
        { "name": "comment.line.number-sign.dpy", "match": "#.*$" }
      ]
    },
    "zeichenketten": {
      "patterns": [
        {
          "name": "string.quoted.double.dpy",
          "begin": "([rRbBuUfF]{0,2})(\"\"\")",
          "end": "\"\"\"",
          "beginCaptures": { "1": { "name": "storage.type.string.dpy" } },
          "patterns": [
            { "include": "#format-platzhalter" },
            { "name": "constant.character.escape.dpy", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.dpy",
          "begin": "([rRbBuUfF]{0,2})(''')",
          "end": "'''",
          "beginCaptures": { "1": { "name": "storage.type.string.dpy" } },
          "patterns": [
            { "include": "#format-platzhalter" },
            { "name": "constant.character.escape.dpy", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.double.dpy",
          "begin": "([rRbBuUfF]{0,2})(\")",
          "end": "\"",
          "beginCaptures": { "1": { "name": "storage.type.string.dpy" } },
          "patterns": [
            { "include": "#format-platzhalter" },
            { "name": "constant.character.escape.dpy", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.dpy",
          "begin": "([rRbBuUfF]{0,2})(')",
          "end": "'",
          "beginCaptures": { "1": { "name": "storage.type.string.dpy" } },
          "patterns": [
            { "include": "#format-platzhalter" },
            { "name": "constant.character.escape.dpy", "match": "\\\\." }
          ]
        }
      ]
    },
    "format-platzhalter": {
      "patterns": [
        {
          "name": "meta.embedded.expression.dpy",
          "match": "(\\{)([^{}]*)(\\})",
          "captures": {
            "1": { "name": "punctuation.section.embedded.begin.dpy" },
            "2": { "name": "source.dpy.embedded" },
            "3": { "name": "punctuation.section.embedded.end.dpy" }
          }
        }
      ]
    },
    "zahlen": {
      "patterns": [
        { "name": "constant.numeric.hex.dpy", "match": "\\b0[xX][0-9a-fA-F_]+\\b" },
        { "name": "constant.numeric.bin.dpy", "match": "\\b0[bB][01_]+\\b" },
        { "name": "constant.numeric.oct.dpy", "match": "\\b0[oO][0-7_]+\\b" },
        {
          "name": "constant.numeric.float.dpy",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d+)?[jJ]?\\b"
        },
        {
          "name": "constant.numeric.integer.dpy",
          "match": "\\b\\d[\\d_]*([eE][+-]?\\d+)?[jJ]?\\b"
        }
      ]
    },
    "konstanten": {
      "patterns": [
        { "name": "constant.language.dpy", "match": "\\b(Wahr|Falsch|Nichts)\\b" }
      ]
    },
    "dekoratoren": {
      "patterns": [
        {
          "match": "^\\s*(@)([A-Za-zÀ-ÖØ-öø-ÿ_][A-Za-zÀ-ÖØ-öø-ÿ0-9_.]*)",
          "captures": {
            "1": { "name": "punctuation.definition.decorator.dpy" },
            "2": { "name": "entity.name.function.decorator.dpy" }
          }
        }
      ]
    },
    "schluesselwoerter": {
      "patterns": [
        {
          "name": "keyword.control.dpy",
          "match": "\\b(wenn|sonstwenn|sonst|für|während|abbrechen|weitermachen|versuche|außer|schließlich|werfe|gib_zurück|weiter|liefere|mit|importiere|von|als|nichtlokal|global|lambda|lösche|versichere|asynchron|erwarte|in)\\b"
        },
        {
          "name": "keyword.operator.logical.dpy",
          "match": "\\b(und|oder|nicht|ist)\\b"
        }
      ]
    },
    "eingebaute-funktionen": {
      "patterns": [
        {
          "name": "support.function.builtin.dpy",
          "match": "\\b(drucke|länge|bereich|eingabe|zeichenkette|ganzzahl|gleitkommazahl|liste|wörterbuch|tupel|menge|öffne|typ|größte|kleinste|summe|sortiert|aufzählen|verbinde|print|len|range|input|str|int|float|list|dict|tuple|set|open|type|max|min|sum|sorted|enumerate|zip|isinstance|issubclass|super|repr|hasattr|getattr|setattr)\\b(?=\\s*\\()"
        }
      ]
    },
    "selbst": {
      "patterns": [
        { "name": "variable.language.self.dpy", "match": "\\b(selbst|self|cls|klass)\\b" }
      ]
    },
    "klassendefinition": {
      "begin": "\\b(klasse)\\s+([A-Za-zÀ-ÖØ-öø-ÿ_][A-Za-zÀ-ÖØ-öø-ÿ0-9_]*)",
      "end": "(?=:)",
      "beginCaptures": {
        "1": { "name": "keyword.control.dpy" },
        "2": { "name": "entity.name.class.dpy" }
      },
      "patterns": [
        {
          "match": "([A-Za-zÀ-ÖØ-öø-ÿ_][A-Za-zÀ-ÖØ-öø-ÿ0-9_]*)",
          "name": "entity.other.inherited-class.dpy"
        },
        { "match": "[(),]", "name": "punctuation.dpy" }
      ]
    },
    "funktionsdefinition": {
      "begin": "\\b(funktion)\\s+([A-Za-zÀ-ÖØ-öø-ÿ_][A-Za-zÀ-ÖØ-öø-ÿ0-9_]*)\\s*(\\()",
      "end": "(\\))\\s*(->\\s*[A-Za-zÀ-ÖØ-öø-ÿ_][A-Za-zÀ-ÖØ-öø-ÿ0-9_.\\[\\], ]*)?\\s*(?=:)",
      "beginCaptures": {
        "1": { "name": "keyword.control.dpy" },
        "2": { "name": "entity.name.function.dpy" },
        "3": { "name": "punctuation.dpy" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.dpy" },
        "2": { "name": "storage.type.annotation.dpy" }
      },
      "patterns": [
        { "include": "#selbst" },
        {
          "match": "\\b(selbst|self)\\b",
          "name": "variable.language.self.dpy"
        },
        {
          "match": "([A-Za-zÀ-ÖØ-öø-ÿ_][A-Za-zÀ-ÖØ-öø-ÿ0-9_]*)(?=\\s*[,)=:])",
          "name": "variable.parameter.dpy"
        },
        { "match": "=", "name": "keyword.operator.assignment.dpy" },
        { "match": ":", "name": "punctuation.dpy" },
        { "match": ",", "name": "punctuation.dpy" },
        { "include": "#zeichenketten" },
        { "include": "#zahlen" }
      ]
    },
    "funktionsaufruf": {
      "patterns": [
        {
          "match": "\\b([A-Za-zÀ-ÖØ-öø-ÿ_][A-Za-zÀ-ÖØ-öø-ÿ0-9_]*)(?=\\s*\\()",
          "name": "entity.name.function.call.dpy"
        }
      ]
    },
    "attributzugriff": {
      "patterns": [
        {
          "match": "(\\.)([A-Za-zÀ-ÖØ-öø-ÿ_][A-Za-zÀ-ÖØ-öø-ÿ0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.dpy" },
            "2": { "name": "entity.name.function.member.dpy" }
          }
        },
        {
          "match": "(\\.)([A-Za-zÀ-ÖØ-öø-ÿ_][A-Za-zÀ-ÖØ-öø-ÿ0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.dpy" },
            "2": { "name": "variable.other.property.dpy" }
          }
        }
      ]
    },
    "zuweisung": {
      "patterns": [
        {
          "match": "^\\s*((?:[A-Za-zÀ-ÖØ-öø-ÿ_][A-Za-zÀ-ÖØ-öø-ÿ0-9_]*\\s*,\\s*)*[A-Za-zÀ-ÖØ-öø-ÿ_][A-Za-zÀ-ÖØ-öø-ÿ0-9_]*)\\s*(:[^=]+)?(=)(?!=)",
          "captures": {
            "1": { "name": "variable.other.assigned.dpy" },
            "2": { "name": "storage.type.annotation.dpy" },
            "3": { "name": "keyword.operator.assignment.dpy" }
          }
        },
        {
          "match": "\\b([A-Za-zÀ-ÖØ-öø-ÿ_][A-Za-zÀ-ÖØ-öø-ÿ0-9_]*)\\s*(\\+=|-=|\\*=|/=|//=|%=|\\*\\*=)",
          "captures": {
            "1": { "name": "variable.other.assigned.dpy" },
            "2": { "name": "keyword.operator.assignment.dpy" }
          }
        }
      ]
    },
    "operatoren": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.dpy",
          "match": "\\*\\*|//|[-+*/%@]"
        },
        {
          "name": "keyword.operator.comparison.dpy",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.dpy",
          "match": "\\+=|-=|\\*=|/=|//=|%=|\\*\\*=|="
        },
        {
          "name": "punctuation.separator.dpy",
          "match": "[,:;]"
        },
        {
          "name": "punctuation.bracket.dpy",
          "match": "[\\[\\]{}()]"
        }
      ]
    }
  }
}
