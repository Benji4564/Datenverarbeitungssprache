importiere math
von deutschpython.vokabular importiere drucke

klasse Begrüßung:
    funktion __init__(selbst, name):
        selbst.name = name

    funktion sagen(selbst):
        wenn selbst.name:
            gib_zurück f"Hallo, {selbst.name}!"
        sonst:
            gib_zurück "Hallo, Welt!"


funktion fakultät(n):
    wenn n < 0:
        werfe ValueError("n muss >= 0 sein")
    ergebnis = 1
    für i in range(2, n + 1):
        ergebnis = ergebnis * i
    gib_zurück ergebnis


wenn __name__ == "__main__":
    g = Begrüßung("Welt")
    drucke(g.sagen())
    drucke("5! =", fakultät(5))
    drucke("Wurzel aus 2 =", math.sqrt(2))

    versuche:
        fakultät(-1)
    außer ValueError als fehler:
        drucke("Fehler abgefangen:", fehler)
