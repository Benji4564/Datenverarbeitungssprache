{
  "name": "deutschpython",
  "displayName": "Deutsch-Python",
  "description": "Syntax-Hervorhebung und Ausführung für .dpy-Dateien (Python mit deutschen Schlüsselwörtern), ohne dass der Python-Sprachserver falsche Fehler anzeigt.",
  "version": "0.2.0",
  "publisher": "deutschpython-lokal",
  "license": "PSF-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Benji4564/Datenverarbeitungssprache",
    "directory": "Deutsch/vscode-deutschpython"
  },
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:deutschpython"],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "deutschpython",
        "aliases": ["Deutsch-Python", "deutschpython"],
        "extensions": [".dpy"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "deutschpython",
        "scopeName": "source.dpy",
        "path": "./syntaxes/deutschpython.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "deutschpython.ausfuehren",
        "title": "Deutsch-Python: Datei ausführen",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "deutschpython.ausfuehren",
          "when": "resourceLangId == deutschpython",
          "group": "navigation"
        }
      ]
    }
  }
}
